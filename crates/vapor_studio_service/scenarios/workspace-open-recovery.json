{
  "name": "invalid workspace selection is recoverable",
  "steps": [
    {
      "action": { "family": "workspace", "action": { "action": "open", "root": "./missing-studio-scenario-workspace" } },
      "expect": { "response": "rejected", "error": "invalid-request" }
    },
    {
      "action": { "family": "catalog", "action": { "action": "refresh" } },
      "expect": { "response": "applied", "catalog_len": 1 }
    }
  ]
}
