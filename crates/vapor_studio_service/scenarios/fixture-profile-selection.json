{
  "name": "fixture catalog and profile selection",
  "steps": [
    {
      "action": { "family": "catalog", "action": { "action": "refresh" } },
      "expect": { "response": "applied", "catalog_len": 1 }
    },
    {
      "action": { "family": "catalog", "action": { "action": "inspect", "content_id": "fixture.engine", "version": "1.0.0" } },
      "expect": { "response": "applied", "selected_content_id": "fixture.engine@1.0.0" }
    },
    {
      "action": { "family": "profile", "action": { "action": "select", "profile_id": "default" } },
      "expect": { "response": "applied", "active_profile_id": "default" }
    }
  ]
}
